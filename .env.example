# sync_youtube_ga4.py — приклад .env
# СКОПІЮЙ у .env для локального запуску (і НІКОЛИ не комітьте .env у git).
# Для GitHub Actions ці ж імена йдуть у Repo → Settings → Secrets and variables → Actions.

# ---------------------------------------------------------------------------
# Apps Script Web App — той самий URL, що вже вписаний у index.html (localStorage 'vrkings_url')
# ---------------------------------------------------------------------------
SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXXXX/exec

# ---------------------------------------------------------------------------
# YouTube Analytics API — OAuth для ВЛАСНОГО каналу (не service account:
# Google не дає service account-у аналітику особистого/brand-каналу без
# domain-wide delegation, якого тут немає)
# ---------------------------------------------------------------------------
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Одноразово отримується через OAuth consent (див. README_YOUTUBE_GA4_SYNC.md), далі не змінюється
YOUTUBE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# GA4 Data API — service account (простіше за OAuth: без токенів, що протухають)
# ---------------------------------------------------------------------------
GA4_PROPERTY_ID=123456789
# Увесь вміст JSON-ключа сервісного акаунту ОДНИМ РЯДКОМ
GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Назви custom event parameters на patreon.vrkings.tv, звірено в GA4 UI 21.08.2026
# (Reports → Engagement → Events + Admin → Custom definitions). Подія скролу —
# "scroll_depth" (НЕ стандартна GA4-подія "scroll" на 90%), параметр depth_percent.
# Подія кліку по CTA — "cta_click", параметр cta_button (значення типу
# get_instant_access_hero, start_for_5_pricing тощо); є ще cta_value і button_text
# на тій самій події, але для розбивки по кнопках потрібен саме cta_button.
GA4_SCROLL_DEPTH_PARAM=depth_percent
GA4_CTA_BUTTON_PARAM=cta_button
